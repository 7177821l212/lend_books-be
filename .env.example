APP_ENV=development
APP_NAME=lendbook-be
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql+asyncpg://lendbook:lendbook@localhost:5432/lendbook
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# JWT
JWT_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS
CORS_ORIGINS=["http://localhost:8081","http://localhost:3000"]

# Storage (for proof photos)
GCS_BUCKET_NAME=lendbook-proofs-dev
GOOGLE_APPLICATION_CREDENTIALS=
